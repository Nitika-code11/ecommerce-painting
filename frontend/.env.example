# Backend origin. Leave empty in development to use the Vite proxy (/api -> http://localhost:8080).
# Set it for production builds, e.g. https://api.example.com (the backend must allow this origin via CORS).
VITE_API_BASE_URL=

# Set to "false" to hide create/edit/delete controls (e.g. a public read-only deployment).
VITE_ENABLE_MUTATIONS=true

# Never put secrets in VITE_ variables: they are embedded in the client bundle.
