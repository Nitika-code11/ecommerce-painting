// TypeScript settings for the build tooling (vite.config.ts), which runs in Node rather than the browser.
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],            // no DOM types: this code never runs in a browser
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],            // Node's built-in modules such as "node:path"
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["vite.config.ts"]
}
